   # Copy this file to .env.local and fill in your own values.
   # Never commit .env.local.

   # Supabase → Project Settings → API Keys
   NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

   # Anthropic Console → API Keys (used by /api/generate-plan)
   ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

   # USDA FoodData Central (used by the photo calorie estimator, Enhanced build)
   USDA_API_KEY=your-usda-key