# Supabase: Project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Claude API (workout routines + meal photo estimator): https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional. Defaults to claude-haiku-4-5-20251001
ANTHROPIC_MODEL=

# USDA FoodData Central (calories for the meal photo estimator): https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=your-usda-api-key
